# Copy to .env to override docker-compose defaults (docker compose auto-loads
# a .env file next to docker-compose.yml). All of these have working
# built-in defaults for local use -- override for anything beyond that.

# Django
# DEBUG=True
# SECRET_KEY=django-insecure-0n%0oil&^q!^)jrv)og*k!2hz6*jqz(qnl%09p=8a7c9lvhdc@
# ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Postgres (shared by db + backend services)
# DB_NAME=database
# DB_USER=root
# DB_PASSWORD=mysecretpassword

# Pin recommendations to one algorithm instead of the service's own A/B
# split. Valid values: collaborative, hybrid_content, pure_content.
# RECOMMENDATION_SERVICE_VARIANT=collaborative
